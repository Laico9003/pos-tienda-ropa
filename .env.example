# --- Base de datos ---
DATABASE_URL=postgresql://usuario:password@localhost:5432/pos_tienda_ropa
# Poner en true si el PostgreSQL es administrado (Railway, Render, Neon, Supabase...)
DATABASE_SSL=false

# --- Seguridad ---
JWT_SECRET=cambia_esto_por_una_clave_larga_y_segura
JWT_EXPIRA=12h

# --- Servidor ---
PORT=3000

# --- Reglas de negocio ---
# Stock igual o menor a este valor se considera "stock bajo" en el dashboard
STOCK_BAJO_UMBRAL=5

# --- Facturación electrónica SRI (Fase 3) ---
# Clave para cifrar en la base la contraseña del .p12 y del SMTP.
# Si se deja vacía se usa JWT_SECRET. NO cambiarla después de guardar el certificado.
SRI_CLAVE=
# Trabajador que envía las facturas al SRI en segundo plano. "off" lo desactiva.
SRI_WORKER=on
SRI_WORKER_INTERVALO_MS=15000
SRI_WORKER_MAX_INTENTOS=12
